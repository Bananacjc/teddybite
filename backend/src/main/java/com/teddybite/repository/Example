package com.scorikun.scorify.repository;

import com.scorikun.scorify.entity.pojo.Result;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.stereotype.Repository;

import java.util.List;

@Repository
public interface ResultRepository extends JpaRepository<Result, String> {
    List<Result> findByUserId(String userId);
    List<Result> findByUserIdAndProgramLevelAndYearSem(String userId, String programLevel, String yearSem);
}