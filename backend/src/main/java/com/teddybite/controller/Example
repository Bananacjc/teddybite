package com.scorikun.scorify.controller;

import com.scorikun.scorify.entity.pojo.Result;
import com.scorikun.scorify.service.ResultService;
import lombok.RequiredArgsConstructor;
import org.springframework.web.bind.annotation.*;

import java.util.List;

@RestController
@RequestMapping("/api/results")
@RequiredArgsConstructor
@CrossOrigin(origins = {"http://localhost:3000", "http://localhost:5173", "http://localhost:5174"})
public class ResultController {

    private final ResultService resultService;

    // GET /api/results/{userId}
    @GetMapping("/{userId}")
    public List<Result> getResults(@PathVariable String userId) {
        return resultService.getResultsByUser(userId);
    }

    // GET /api/results/{userId}/{programLevel}/{yearSem}
    @GetMapping("/{userId}/{programLevel}/{yearSem}")
    public List<Result> getResultsByProgramSem(
            @PathVariable String userId,
            @PathVariable String programLevel,
            @PathVariable String yearSem) {
        return resultService.getResultsByUserProgramSem(userId, programLevel, yearSem);
    }

    @PostMapping
    public Result createResult(@RequestBody Result result) {
        return resultService.saveResult(result);
    }

    @PutMapping("/{id}")
    public Result updateResult(@PathVariable String id, @RequestBody Result result) {
        result.setResultId(id);
        return resultService.saveResult(result);
    }

    @DeleteMapping("/{id}")
    public void deleteResult(@PathVariable String id) {
        resultService.deleteResult(id);
    }
}